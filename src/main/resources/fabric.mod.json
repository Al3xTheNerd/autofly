{
	"schemaVersion": 1,
	"id": "autofly",
	"version": "${version}",
	"name": "Autofly",
	"description": "This mod is used to automatically enable /fly when switching worlds or logging in!",
	"authors": [
		"AlexTheNerd"
	],
	"contact": {
		"homepage": "https://www.atn.gg/"
	},
	"license": "CC0-1.0",
	"icon": "assets/autofly/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"gg.atn.Autofly"
		],
		"client": [
			"gg.atn.client.AutoflyClient"
		]
	},
	"mixins": [
		"autofly.mixins.json",
		{
			"config": "autofly.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}